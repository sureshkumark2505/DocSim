{
  "name": "docsim",
  "version": "1.0.0",
  "description": "DocSim - Document Similarity Detection Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node -r dotenv/config --test tests/scans.test.js tests/level2.test.js tests/dashboard.test.js",
    "test:l1": "node -r dotenv/config --test tests/scans.test.js",
    "test:l2": "node -r dotenv/config --test tests/level2.test.js",
    "test:dashboard": "node -r dotenv/config --test tests/dashboard.test.js",
    "benchmark": "node -r dotenv/config benchmark.js",
    "py:start": "python python-engine/main.py",
    "py:test": "python python-engine/test_engine.py"
  },
  "keywords": [
    "jaccard",
    "document-similarity",
    "express",
    "mysql",
    "docsim"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^6.0.0",
    "mammoth": "^1.11.0",
    "mongodb": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.18.2",
    "pdf-parse": "^2.4.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7"
  }
}
