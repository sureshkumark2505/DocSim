# Server Port
PORT=3001

# Python High-Performance Acceleration Engine
PYTHON_ENGINE_URL=http://127.0.0.1:8000

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=SIMILARITY

# Redis Configuration (BullMQ Queue Backend)
# Prefer REDIS_URL if provided, else use host/port/password
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Upload Limits
MAX_FILES=1000
MAX_FILE_SIZE_MB=20
MAX_TOTAL_UPLOAD_SIZE_MB=500

# Batch & Retention Settings
DB_BATCH_SIZE=1000
TEMP_FILE_RETENTION_HOURS=24
SIMILARITY_THRESHOLD=0.80

# Level 2 Algorithm Parameters
SHINGLE_SIZE=5
MINHASH_NUM_PERMUTATIONS=128
LSH_BANDS=32
LSH_ROWS=4

# Worker Concurrency
DOCUMENT_WORKER_CONCURRENCY=4
COMPARISON_WORKER_CONCURRENCY=4
